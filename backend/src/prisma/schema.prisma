generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                Int              @id @default(autoincrement())
  name              String
  email             String           @unique
  passwordHash      String
  role              String           @default("reader")
  photoUrl          String           @default("")
  active            Boolean          @default(true)
  authVersion       Int              @default(0)
  productionStoreId Int?
  powerBiAccess     PowerBiAccess?
  productionStore   ProductionStore? @relation("UserProductionStore", fields: [productionStoreId], references: [id], onDelete: SetNull)
  createdStockCounts StockCount[]     @relation("StockCountCreatedBy")

  @@index([productionStoreId])
}

model LoginThrottle {
  id              Int       @id @default(autoincrement())
  scope           String
  keyHash         String
  failureCount    Int       @default(0)
  lockLevel       Int       @default(0)
  windowStartedAt DateTime
  lockedUntil     DateTime?
  lastFailedAt    DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([scope, keyHash])
  @@index([lockedUntil])
  @@index([updatedAt])
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  iconKey   String   @default("default")
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id          Int               @id @default(autoincrement())
  title       String
  slug        String            @unique
  summary     String            @default("")
  category    String
  content     String
  status      String            @default("published")
  sortOrder   Int               @default(0)
  tags        String            @default("")
  author      String            @default("Admin")
  authorPhoto String            @default("")
  updatedBy   String            @default("Admin")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  revisions   ArticleRevision[]

  @@index([status, sortOrder, updatedAt])
  @@index([category])
}

model ArticleRevision {
  id        Int      @id @default(autoincrement())
  articleId Int
  title     String
  summary   String   @default("")
  category  String
  content   String
  status    String
  tags      String   @default("")
  updatedBy String   @default("Admin")
  createdAt DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

model PoolParticipant {
  id        Int      @id @default(autoincrement())
  name      String
  photoUrl  String
  score     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([score, name])
}

model AppSettings {
  id             Int      @id @default(1)
  poolEnabled    Boolean  @default(true)
  powerBiEnabled Boolean  @default(true)
  powerBiUrl     String   @default("")
  updatedAt      DateTime @updatedAt
}

model PowerBiAccess {
  userId    Int      @id
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProductionProduct {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  name             String
  active           Boolean  @default(true)
  showInStockCount Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  sourceConversions ProductionConversion[] @relation("ProductionConversionSource")
  planningItems ProductionPlanningItem[]
  stockCountItems StockCountItem[]

  @@index([active, code])
}

model ProductionConversion {
  id              Int               @id @default(autoincrement())
  sourceProductId Int               @unique
  conversionCode  String
  conversionName  String
  conversionFactor Decimal
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  sourceProduct   ProductionProduct @relation("ProductionConversionSource", fields: [sourceProductId], references: [id])

  @@index([active, sourceProductId])
  @@index([conversionCode])
}

model ProductionStore {
  id          Int                    @id @default(autoincrement())
  sourceCode  String                 @unique
  sourceName  String
  displayName String
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  routes      ProductionStoreRoute[]
  planningStores ProductionPlanningStore[]
  users       User[]                  @relation("UserProductionStore")
  stockCounts StockCount[]

  @@index([active, displayName])
}

model StockCount {
  id                Int              @id @default(autoincrement())
  productionStoreId Int
  storeName         String
  stockDate         String
  status            String           @default("draft")
  createdById       Int
  createdByName     String
  finalizedAt       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  productionStore   ProductionStore  @relation(fields: [productionStoreId], references: [id], onDelete: Restrict)
  createdBy         User             @relation("StockCountCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  items             StockCountItem[]

  @@index([productionStoreId, stockDate, status])
  @@index([stockDate, status])
  @@index([createdById])
}

model StockCountItem {
  id                  Int               @id @default(autoincrement())
  stockCountId        Int
  productionProductId Int
  code                String
  name                String
  quantity            Decimal?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  stockCount          StockCount        @relation(fields: [stockCountId], references: [id], onDelete: Cascade)
  productionProduct   ProductionProduct @relation(fields: [productionProductId], references: [id], onDelete: Restrict)

  @@unique([stockCountId, productionProductId])
  @@index([stockCountId, code])
}

model ProductionPlanningDay {
  id                   Int                       @id @default(autoincrement())
  day                  String                    @unique
  comparisonStartDate  String
  comparisonEndDate    String
  status               String                    @default("nao_iniciado")
  productionStartedAt  DateTime?
  productionFinishedAt DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  stores               ProductionPlanningStore[]

  @@index([day, status])
  @@index([createdAt])
}

model ProductionPlanningStore {
  id                     Int                      @id @default(autoincrement())
  planningDayId          Int
  productionStoreId      Int
  storeName              String
  defaultIncreasePercent Decimal?
  planningDay            ProductionPlanningDay    @relation(fields: [planningDayId], references: [id], onDelete: Cascade)
  productionStore        ProductionStore          @relation(fields: [productionStoreId], references: [id])
  products               ProductionPlanningItem[]

  @@unique([planningDayId, productionStoreId])
  @@index([planningDayId, storeName])
}

model ProductionPlanningItem {
  id                  Int                     @id @default(autoincrement())
  planningStoreId     Int
  productionProductId Int
  code                String
  name                String
  family              String                  @default("")
  averageSold         Decimal                 @default(0)
  servedDates         String                  @default("[]")
  stockQuantity       Decimal?
  stockStatus         String                  @default("unavailable")
  stockDate           String                  @default("")
  stockReason         String                  @default("")
  stockSource         String                  @default("")
  increasePercent     Decimal?
  fixedQuantity       Decimal                 @default(0)
  orderQuantity       Decimal                 @default(0)
  fixedOrderSources   String                  @default("[]")
  stockSources        String                  @default("[]")
  suggestion          Decimal                 @default(0)
  importedOnly        Boolean                 @default(false)
  dispatchStatus      String?
  actualQuantity      Decimal?
  justification       String                  @default("")
  planningStore       ProductionPlanningStore @relation(fields: [planningStoreId], references: [id], onDelete: Cascade)
  productionProduct   ProductionProduct       @relation(fields: [productionProductId], references: [id])

  @@unique([planningStoreId, productionProductId])
  @@index([planningStoreId, code])
  @@index([dispatchStatus])
}

model ProductionStoreRoute {
  id        Int             @id @default(autoincrement())
  storeId   Int
  weekday   Int
  active    Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  store     ProductionStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, weekday])
  @@index([active, weekday])
}
